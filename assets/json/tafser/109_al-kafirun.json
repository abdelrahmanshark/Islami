{
  "surah": "الكافرون",
  "number": 109,
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "قُلْ يَا أَيُّهَا الْكَافِرُونَ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "قل -أيها الرسول- للذين كفروا بالله ورسوله: يا أيها الكافرون بالله."
        }
      ]
    },
    {
      "ayah_number": 2,
      "text": "لَا أَعْبُدُ مَا تَعْبُدُونَ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "لا أعبد ما تعبدون من الأصنام والآلهة الزائفة."
        }
      ]
    },
    {
      "ayah_number": 3,
      "text": "وَلَا أَنتُمْ عَابِدُونَ مَا أَعْبُدُ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "ولا أنتم عابدون ما أعبد من إله واحد، هو الله رب العالمين المستحق وحده للعبادة."
        }
      ]
    },
    {
      "ayah_number": 4,
      "text": "وَلَا أَنَا عَابِدٌ مَّا عَبَدتُّمْ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "ولا أنا عابد ما عبدتم من الأصنام والآلهة الباطلة."
        }
      ]
    },
    {
      "ayah_number": 5,
      "text": "وَلَا أَنتُمْ عَابِدُونَ مَا أَعْبُدُ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "ولا أنتم عابدون مستقبلا ما أعبد. وهذه الآية نزلت في أشخاص بأعيانهم من المشركين، قد علم الله أنهم لا يؤمنون أبدًا."
        }
      ]
    },
    {
      "ayah_number": 6,
      "text": "لَكُمْ دِينُكُمْ وَلِيَ دِينِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "لكم دينكم الذي أصررتم على اتباعه، ولي ديني الذي لا أبغي غيره."
        }
      ]
    }
  ]
}