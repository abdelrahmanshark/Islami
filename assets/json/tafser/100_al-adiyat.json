{
  "surah": "العاديات",
  "number": 100,
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "وَالْعَادِيَاتِ ضَبْحًا",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "أقسم الله تعالى بالخيل الجاريات في سبيله نحو العدوِّ، حين يظهر صوتها من سرعة عَدْوِها. ولا يجوز للمخلوق أن يقسم إلا بالله، فإن القسم بغير الله شرك."
        }
      ]
    },
    {
      "ayah_number": 2,
      "text": "فَالْمُورِيَاتِ قَدْحًا",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "فالخيل اللاتي تنقدح النار من صلابة حوافرها؛ من شدَّة عَدْوها."
        }
      ]
    },
    {
      "ayah_number": 3,
      "text": "فَالْمُغِيرَاتِ صُبْحًا",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "فالمغيرات على الأعداء عند الصبح."
        }
      ]
    },
    {
      "ayah_number": 4,
      "text": "فَأَثَرْنَ بِهِ نَقْعًا",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "فهيَّجْنَ بهذا العَدْو غبارًا."
        }
      ]
    },
    {
      "ayah_number": 5,
      "text": "فَوَسَطْنَ بِهِ جَمْعًا",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "فتوسَّطن بركبانهن جموع الأعداء."
        }
      ]
    },
    {
      "ayah_number": 6,
      "text": "إِنَّ الْإِنسَانَ لِرَبِّهِ لَكَنُودٌ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "إن الإنسان لِنعم ربه لَجحود، وإنه بجحوده ذلك لمقر. وإنه لحب المال لشديد."
        }
      ]
    },
    {
      "ayah_number": 7,
      "text": "وَإِنَّهُ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "إن الإنسان لِنعم ربه لَجحود، وإنه بجحوده ذلك لمقر. وإنه لحب المال لشديد."
        }
      ]
    },
    {
      "ayah_number": 8,
      "text": "وَإِنَّهُ لِحُبِّ الْخَيْرِ لَشَدِيدٌ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "إن الإنسان لِنعم ربه لَجحود، وإنه بجحوده ذلك لمقر. وإنه لحب المال لشديد."
        }
      ]
    },
    {
      "ayah_number": 9,
      "text": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِي الْقُبُورِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "أفلا يعلم الإنسان ما ينتظره إذا أخرج الله الأموات من القبور للحساب والجزاء؟"
        }
      ]
    },
    {
      "ayah_number": 10,
      "text": "وَحُصِّلَ مَا فِي الصُّدُورِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "واستُخرج ما استتر في الصدور من خير أو شر."
        }
      ]
    },
    {
      "ayah_number": 11,
      "text": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "إن ربهم بهم وبأعمالهم يومئذ لخبير، لا يخفى عليه شيء من ذلك."
        }
      ]
    }
  ]
}