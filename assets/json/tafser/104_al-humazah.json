{
  "surah": "الهمزة",
  "number": 104,
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "شر وهلاك لكل مغتاب للناس، طعان فيهم."
        }
      ]
    },
    {
      "ayah_number": 2,
      "text": "الَّذِي جَمَعَ مَالًا وَعَدَّدَهُ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "الذي كان همُّه جمع المال وتعداده."
        }
      ]
    },
    {
      "ayah_number": 3,
      "text": "يَحْسَبُ أَنَّ مَالَهُ أَخْلَدَهُ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "يظن أنه ضَمِنَ لنفسه بهذا المال الذي جمعه، الخلود في الدنيا والإفلات من الحساب."
        }
      ]
    },
    {
      "ayah_number": 4,
      "text": "كَلَّا ۖ لَيُنبَذَنَّ فِي الْحُطَمَةِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "ليس الأمر كما ظن، ليُطرحنَّ في النار التي تهشم كل ما يُلْقى فيها."
        }
      ]
    },
    {
      "ayah_number": 5,
      "text": "وَمَا أَدْرَاكَ مَا الْحُطَمَةُ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "وما أدراك -أيها الرسول- ما حقيقة النار؟"
        }
      ]
    },
    {
      "ayah_number": 6,
      "text": "نَارُ اللَّهِ الْمُوقَدَةُ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "إنها نار الله الموقدة التي من شدتها تنفُذ من الأجسام إلى القلوب."
        }
      ]
    },
    {
      "ayah_number": 7,
      "text": "الَّتِي تَطَّلِعُ عَلَى الْأَفْئِدَةِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "إنها نار الله الموقدة التي من شدتها تنفُذ من الأجسام إلى القلوب."
        }
      ]
    },
    {
      "ayah_number": 8,
      "text": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "إنها عليهم مطبَقة في سلاسل وأغلال مطوَّلة؛ لئلا يخرجوا منها."
        }
      ]
    },
    {
      "ayah_number": 9,
      "text": "فِي عَمَدٍ مُّمَدَّدَةٍ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "إنها عليهم مطبَقة في سلاسل وأغلال مطوَّلة؛ لئلا يخرجوا منها."
        }
      ]
    }
  ]
}