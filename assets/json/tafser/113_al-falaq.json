{
  "surah": "الفلق",
  "number": 113,
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "قل -أيها الرسول-: أعوذ وأعتصم برب الفلق، وهو الصبح."
        }
      ]
    },
    {
      "ayah_number": 2,
      "text": "مِن شَرِّ مَا خَلَقَ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "من شر جميع المخلوقات وأذاها."
        }
      ]
    },
    {
      "ayah_number": 3,
      "text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "ومن شر ليل شديد الظلمة إذا دخل وتغلغل، وما فيه من الشرور والمؤذيات."
        }
      ]
    },
    {
      "ayah_number": 4,
      "text": "وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "ومن شر الساحرات اللاتي ينفخن فيما يعقدن من عُقَد بقصد السحر."
        }
      ]
    },
    {
      "ayah_number": 5,
      "text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "ومن شر حاسد مبغض للناس إذا حسدهم على ما وهبهم الله من نعم، وأراد زوالها عنهم، وإيقاع الأذى بهم."
        }
      ]
    }
  ]
}