{
  "surah": "الناس",
  "number": 114,
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "قُلْ أَعُوذُ بِرَبِّ النَّاسِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "قل -أيها الرسول-: أعوذ وأعتصم برب الناس، القادر وحده على ردِّ شر الوسواس."
        }
      ]
    },
    {
      "ayah_number": 2,
      "text": "مَلِكِ النَّاسِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "ملك الناس المتصرف في كل شؤونهم، الغنيِّ عنهم."
        }
      ]
    },
    {
      "ayah_number": 3,
      "text": "إِلَٰهِ النَّاسِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "إله الناس الذي لا معبود بحق سواه."
        }
      ]
    },
    {
      "ayah_number": 4,
      "text": "مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "من أذى الشيطان الذي يوسوس عند الغفلة، ويختفي عند ذكر الله."
        }
      ]
    },
    {
      "ayah_number": 5,
      "text": "الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "الذي يبثُّ الشر والشكوك في صدور الناس."
        }
      ]
    },
    {
      "ayah_number": 6,
      "text": "مِنَ الْجِنَّةِ وَالنَّاسِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "من شياطين الجن والإنس."
        }
      ]
    }
  ]
}