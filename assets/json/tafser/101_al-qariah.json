{
  "surah": "القارعة",
  "number": 101,
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "الْقَارِعَةُ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "الساعة التي تقرع قلوب الناس بأهوالها."
        }
      ]
    },
    {
      "ayah_number": 2,
      "text": "مَا الْقَارِعَةُ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "أيُّ شيء هذه القارعة؟"
        }
      ]
    },
    {
      "ayah_number": 3,
      "text": "وَمَا أَدْرَاكَ مَا الْقَارِعَةُ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "وأيُّ شيء أعلمك بها؟"
        }
      ]
    },
    {
      "ayah_number": 4,
      "text": "يَوْمَ يَكُونُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوثِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "في ذلك اليوم يكون الناس في كثرتهم وتفرقهم وحركتهم كالفراش المنتشر، وهو الذي يتساقط في النار."
        }
      ]
    },
    {
      "ayah_number": 5,
      "text": "وَتَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنفُوشِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "وتكون الجبال كالصوف متعدد الألوان الذي يُنْفَش باليد، فيصير هباء ويزول."
        }
      ]
    },
    {
      "ayah_number": 6,
      "text": "فَأَمَّا مَن ثَقُلَتْ مَوَازِينُهُ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "فأما من رجحت موازين حسناته، فهو في حياة مرضية في الجنة."
        }
      ]
    },
    {
      "ayah_number": 7,
      "text": "فَهُوَ فِي عِيشَةٍ رَّاضِيَةٍ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "فأما من رجحت موازين حسناته، فهو في حياة مرضية في الجنة."
        }
      ]
    },
    {
      "ayah_number": 8,
      "text": "وَأَمَّا مَنْ خَفَّتْ مَوَازِينُهُ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "وأما من خفت موازين حسناته، ورجحت موازين سيئاته، فمأواه جهنم."
        }
      ]
    },
    {
      "ayah_number": 9,
      "text": "فَأُمُّهُ هَاوِيَةٌ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "وأما من خفت موازين حسناته، ورجحت موازين سيئاته، فمأواه جهنم."
        }
      ]
    },
    {
      "ayah_number": 10,
      "text": "وَمَا أَدْرَاكَ مَا هِيَهْ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "وما أدراك -أيها الرسول- ما هذه الهاوية؟"
        }
      ]
    },
    {
      "ayah_number": 11,
      "text": "نَارٌ حَامِيَةٌ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "إنها نار قد حَمِيت من الوقود عليها."
        }
      ]
    }
  ]
}