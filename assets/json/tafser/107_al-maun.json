{
  "surah": "الماعون",
  "number": 107,
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "أَرَأَيْتَ الَّذِي يُكَذِّبُ بِالدِّينِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "أرأيت حال ذلك الذي يكذِّب بالبعث والجزاء؟"
        }
      ]
    },
    {
      "ayah_number": 2,
      "text": "فَذَٰلِكَ الَّذِي يَدُعُّ الْيَتِيمَ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "فذلك الذي يدفع اليتيم بعنف وشدة عن حقه؛ لقساوة قلبه."
        }
      ]
    },
    {
      "ayah_number": 3,
      "text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ الْمِسْكِينِ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "ولا يحضُّ غيره على إطعام المسكين، فكيف له أن يطعمه بنفسه؟"
        }
      ]
    },
    {
      "ayah_number": 4,
      "text": "فَوَيْلٌ لِّلْمُصَلِّينَ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "فعذاب شديد للمصلين الذين هم عن صلاتهم لاهون، لا يقيمونها على وجهها، ولا يؤدونها في وقتها."
        }
      ]
    },
    {
      "ayah_number": 5,
      "text": "الَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "فعذاب شديد للمصلين الذين هم عن صلاتهم لاهون، لا يقيمونها على وجهها، ولا يؤدونها في وقتها."
        }
      ]
    },
    {
      "ayah_number": 6,
      "text": "الَّذِينَ هُمْ يُرَاءُونَ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "الذين هم يتظاهرون بأعمال الخير مراءاة للناس."
        }
      ]
    },
    {
      "ayah_number": 7,
      "text": "وَيَمْنَعُونَ الْمَاعُونَ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "ويمنعون إعارة ما لا تضر إعارته من الآنية وغيرها، فلا هم أحسنوا عبادة ربهم، ولا هم أحسنوا إلى خلقه."
        }
      ]
    }
  ]
}