{
  "surah": "الإخلاص",
  "number": 112,
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "قُلْ هُوَ اللَّهُ أَحَدٌ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "قل -أيها الرسول-: هو الله المتفرد بالألوهية والربوبية والأسماء والصفات، لا يشاركه أحد فيها."
        }
      ]
    },
    {
      "ayah_number": 2,
      "text": "اللَّهُ الصَّمَدُ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "الله وحده المقصود في قضاء الحوائج والرغائب."
        }
      ]
    },
    {
      "ayah_number": 3,
      "text": "لَمْ يَلِدْ وَلَمْ يُولَدْ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "ليس له ولد ولا والد ولا صاحبة."
        }
      ]
    },
    {
      "ayah_number": 4,
      "text": "وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ",
      "tafsir": [
        {
          "type": "التفسير الميسر",
          "text": "ولم يكن له مماثلا ولا مشابهًا أحد من خلقه، لا في أسمائه ولا في صفاته، ولا في أفعاله، تبارك وتعالى وتقدَّس."
        }
      ]
    }
  ]
}